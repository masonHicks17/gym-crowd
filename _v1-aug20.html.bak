2026-08-20T11:41:15.723|R|49`;

const DAYS = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
const H0 = 5, H1 = 23;

/* Rows logged before is_closed was added to the sheet have no flag. These are
   the 13 that were closed, all of them the volleyball court. Harmless once
   every row carries the column. */
const CLOSED_BACKFILL = new Set([
  "V|2026-08-01T19:32", "V|2026-08-02T11:32", "V|2026-08-04T06:35",
  "V|2026-08-05T07:28", "V|2026-08-06T05:36", "V|2026-08-07T06:32",
  "V|2026-08-08T10:32", "V|2026-08-14T10:31", "V|2026-08-14T18:53",
  "V|2026-08-15T21:08", "V|2026-08-17T10:32", "V|2026-08-17T22:54",
  "V|2026-08-19T22:41"
]);
const isTrue = v => /^(true|yes|1|__yes__)$/i.test(String(v||"").trim());

let rows = [], loc = "SWRC Weight Room", range = "term";

/* ---------- parsing ---------- */
// source_updated_at is already naive US/Eastern, so no conversion needed.
// Google Sheets rewrites timestamps on import: "2026-08-01T10:27:25.82"
// comes back as "2026-08-01 10:27:26" — space separator, no fractional
// seconds, rounded up, and sometimes a 1-digit hour ("2026-08-02 9:28:28").
// Accept every one of those shapes.
function parseLocal(s){
  const m = String(s).match(/(\d{4})-(\d{1,2})-(\d{1,2})[T ](\d{1,2}):(\d{2}):(\d{2})/);
  if(!m) return null;
  return new Date(+m[1], +m[2]-1, +m[3], +m[4], +m[5], +m[6]);
}
/* Sub-second rounding means an exact string match can't be trusted, so the
   closed-row lookup is keyed to the minute instead. Polls are hourly, so a
   location can't have two readings inside one minute. */
function minuteKey(code, s){
  const d = parseLocal(s);
  if(!d) return code+"|?";
  const p = n => String(n).padStart(2,"0");
  return code+"|"+d.getFullYear()+"-"+p(d.getMonth()+1)+"-"+p(d.getDate())+
         "T"+p(d.getHours())+":"+p(d.getMinutes());
}
function fromSnapshot(txt){
  return txt.trim().split("\n").filter(Boolean).map(l=>{
    const [src,code,cnt] = l.split("|");
    const meta = BY_CODE[code];
    const count = +cnt;
    return {t:parseLocal(src), name:meta.name, cap:meta.cap, count, iso:src,
            closed: CLOSED_BACKFILL.has(minuteKey(code,src)) ||
                    (meta.zeroMeansClosed && count===0)};
  }).filter(r=>r.t);
}
function fromCSV(txt){
  const lines = txt.trim().split(/\r?\n/);
  const head = lines[0].split(",").map(s=>s.trim());
  const ix = n => head.indexOf(n);
  const iName = ix("location_name"), iCnt = ix("last_count"),
        iCap = ix("total_capacity"), iSrc = ix("source_updated_at"),
        iCls = ix("is_closed");                 // -1 on older sheets
  if(iName<0||iCnt<0||iSrc<0) throw new Error("unexpected columns");
  const out = [];
  for(let i=1;i<lines.length;i++){
    const c = lines[i].split(",");
    if(c.length < head.length - (iCls<0?0:1)) continue;
    const name = c[iName].trim();
    if(!LOCS[name]) continue;
    const src = c[iSrc].trim();
    const t = parseLocal(src);
    if(!t) continue;
    const flagged = iCls >= 0 && isTrue(c[iCls]);
    const count = +c[iCnt];
    const meta = LOCS[name];
    out.push({t, name, cap:+c[iCap] || meta.cap, count, iso:src,
              closed: flagged || CLOSED_BACKFILL.has(minuteKey(meta.code,src)) ||
                      (meta.zeroMeansClosed && count===0)});
  }
  return out;
}

/* ---------- helpers ---------- */
const dow = d => (d.getDay()+6)%7;               // 0 = Mon
const ymd = d => d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
/* Not clamped. A count above the posted limit is real information — a queue
   at the door, or staff letting extra people in — not a broken reading. */
const pct = r => r.cap ? 100*r.count/r.cap : 0;
function quantile(a,q){
  if(!a.length) return null;
  const s=[...a].sort((x,y)=>x-y), p=(s.length-1)*q, lo=Math.floor(p), hi=Math.ceil(p);
  return lo===hi ? s[lo] : s[lo]+(s[hi]-s[lo])*(p-lo);
}
function hourLabel(h){
  if(h===0) return "12a"; if(h===12) return "12p";
  return h<12 ? h+"a" : (h-12)+"p";
}
function ago(d){
  const m = Math.round((Date.now()-d.getTime())/60000);
  if(m<60) return m+" min ago";
  const h = Math.floor(m/60);
  return h<24 ? h+"h "+(m%60)+"m ago" : Math.floor(h/24)+"d ago";
}
function ramp(p){                                  // plate colours
  if(p<25) return "var(--p10)";
  if(p<60) return "var(--p15)";
  return "var(--p25)";
}
function shade(p){                                 // opacity within a band
  const within = p<25 ? p/25 : p<60 ? (p-25)/35 : Math.min(1,(p-60)/40);
  return 0.55 + 0.45*within;
}

/* ---------- selection ---------- */
/* is_closed is authoritative. A count of 0 with is_closed false is the gym
   genuinely open and empty, which is a real (and useful) quiet reading —
   46 of the 59 zeros in this data are exactly that. Only drop rows the
   board itself flags as closed. */
function selected(){
  let r = rows.filter(x=>x.name===loc && !x.closed);
  if(range==="term") r = r.filter(x=>ymd(x.t) >= TERM_START);
  return r.sort((a,b)=>a.t-b.t);
}

/* ---------- render: now ---------- */
function renderNow(all){
  const mine = rows.filter(x=>x.name===loc).sort((a,b)=>a.t-b.t);
  const last = mine[mine.length-1];
  const cap = LOCS[loc].cap;
  if(!last){ document.getElementById("nowCount").textContent="—"; return; }
  const p = pct(last);
  document.getElementById("nowCount").textContent = last.count;
  document.getElementById("nowOf").textContent = "of "+cap;
  document.getElementById("nowPct").innerHTML = last.closed
    ? "<b>Closed</b> right now"
    : "<b>"+Math.round(p)+"%</b> full";
  document.getElementById("nowAgo").textContent = ago(last.t);
  const bar = document.getElementById("nowBar");
  bar.style.width = Math.min(100,p)+"%";   // fill can't exceed the track
  bar.style.background = ramp(p);

  const over = mine.filter(r=>r.count > r.cap).length;
  const note = document.getElementById("capNote");
  if(over){
    const max = Math.max(...mine.map(r=>r.count));
    note.hidden = false;
    note.innerHTML = "<b>This room runs over its posted limit.</b> RecSports lists "+cap+
      ", and "+over+" readings have come in higher (highest: "+max+", or "+
      Math.round(100*max/cap)+"%). Shown as recorded — above 100% usually means "+
      "a queue at the door or staff letting extra people in.";
  } else note.hidden = true;
}

/* ---------- render: quietest hours ---------- */
function renderSlots(data){
  const buckets = {};
  data.forEach(r=>{
    const h = r.t.getHours();
    if(h<H0||h>H1) return;
    (buckets[h] = buckets[h] || []).push(pct(r));
  });
  const ranked = Object.entries(buckets)
    .filter(([,v])=>v.length>=2)
    .map(([h,v])=>({h:+h, med:quantile(v,.5), n:v.length}))
    .sort((a,b)=>a.med-b.med).slice(0,3);
  const el = document.getElementById("slots");
  if(!ranked.length){
    el.innerHTML = '<div class="slot"><div class="t">Not enough yet</div>'+
      '<div class="v">need 2+ readings in an hour</div></div>';
    return;
  }
  el.innerHTML = ranked.map(s=>
    '<div class="slot"><div class="t">'+hourLabel(s.h)+"–"+hourLabel((s.h+1)%24)+'</div>'+
    '<div class="v">'+Math.round(s.med)+"% typical · "+s.n+' readings</div></div>').join("");
}

/* ---------- render: heatmap ---------- */
let HEAT = {};
function heatReadout(d,hr){
  const v = HEAT[d+"|"+hr];
  const el = document.getElementById("hmRead");
  if(!v){
    el.innerHTML = "<b>"+DAYS[d]+" "+hourLabel(hr)+"</b> <span class='dim'>· no readings yet</span>";
    return;
  }
  const med = quantile(v.p,.5), lo = Math.min(...v.c), hi = Math.max(...v.c);
  el.innerHTML = "<b>"+DAYS[d]+" "+hourLabel(hr)+"–"+hourLabel((hr+1)%24)+"</b> · <b>"+
    Math.round(med)+"%</b> typical · "+
    (lo===hi ? lo+" people" : lo+"–"+hi+" people")+
    " <span class='dim'>· "+v.p.length+(v.p.length===1?" reading (provisional)":" readings")+"</span>";
}
function renderHeat(data){
  HEAT = {};
  data.forEach(r=>{
    const hr = r.t.getHours();
    if(hr<H0||hr>H1) return;
    const k = dow(r.t)+"|"+hr;
    (HEAT[k] = HEAT[k] || {p:[],c:[]});
    HEAT[k].p.push(pct(r)); HEAT[k].c.push(r.count);
  });
  let html = "<tr><th class='day'></th>";
  for(let hr=H0;hr<=H1;hr++) html += "<th>"+(hr%2===H0%2?hourLabel(hr):"")+"</th>";
  html += "</tr>";
  for(let d=0;d<7;d++){
    html += "<tr><th class='day'>"+DAYS[d]+"</th>";
    for(let hr=H0;hr<=H1;hr++){
      const v = HEAT[d+"|"+hr];
      const at = " data-d='"+d+"' data-h='"+hr+"'";
      if(!v) html += "<td"+at+"></td>";
      else{
        const m = quantile(v.p,.5), solo = v.p.length===1;
        html += "<td"+at+" style='background:"+ramp(m)+";opacity:"+
          (solo?0.34:shade(m)).toFixed(2)+"' title='"+DAYS[d]+" "+hourLabel(hr)+
          " · "+Math.round(m)+"%'></td>";
      }
    }
    html += "</tr>";
  }
  const tbl = document.getElementById("hm");
  tbl.innerHTML = html;

  let locked = null;
  const mark = td => {
    tbl.querySelectorAll("td.sel").forEach(x=>x.classList.remove("sel"));
    if(td) td.classList.add("sel");
  };
  const show = e => {
    const td = e.target.closest("td[data-d]");
    if(!td) return;
    mark(td);
    heatReadout(+td.dataset.d, +td.dataset.h);
  };
  tbl.addEventListener("mousemove", e=>{ if(!locked) show(e); });
  tbl.addEventListener("mouseleave", ()=>{
    if(locked) return;
    mark(null);
    document.getElementById("hmRead").innerHTML =
      "<span class='dim'>Tap or hover any block for that hour\u2019s numbers.</span>";
  });
  // tap locks a cell so the readout survives lifting your finger
  tbl.addEventListener("click", e=>{
    const td = e.target.closest("td[data-d]");
    if(!td) return;
    locked = (locked===td) ? null : td;
    show(e);
  });
}

/* ---------- render: today vs typical ---------- */
function renderChart(data){
  const today = ymd(new Date());
  const todayRows = data.filter(r=>ymd(r.t)===today);
  const weekendNow = dow(new Date())>=5;
  document.getElementById("dayKind").textContent = weekendNow ? "weekend day" : "weekday";

  // Only a couple of same-weekday samples exist, so the band pools all
  // weekdays (or both weekend days) instead of matching the exact day.
  const band = {};
  data.forEach(r=>{
    if(ymd(r.t)===today) return;
    if((dow(r.t)>=5) !== weekendNow) return;
    const hr=r.t.getHours(); if(hr<H0||hr>H1) return;
    (band[hr] = band[hr] || []).push(pct(r));
  });
  const todayBy = {};
  todayRows.forEach(r=>{
    const hr=r.t.getHours(); if(hr<H0||hr>H1) return;
    (todayBy[hr] = todayBy[hr] || []).push(r);
  });

  const W=860,H=260,PL=44,PR=14,PT=14,PB=28;
  const top = Math.max(100, ...data.map(pct));      // headroom for over-capacity
  const x = hr => PL + (hr-H0)/(H1-H0)*(W-PL-PR);
  const y = p => PT + (1-p/top)*(H-PT-PB);

  let g = "";
  const stepY = top>100 ? 50 : 25;
  for(let p=0;p<=top;p+=stepY){
    g += "<line x1='"+PL+"' y1='"+y(p)+"' x2='"+(W-PR)+"' y2='"+y(p)+
         "' stroke='var(--line)' stroke-width='1'/>"+
         "<text class='ax' x='"+(PL-8)+"' y='"+(y(p)+3.5)+"' text-anchor='end'>"+p+"%</text>";
  }
  if(top>100)   // mark the posted limit once the scale runs past it
    g += "<line x1='"+PL+"' y1='"+y(100)+"' x2='"+(W-PR)+"' y2='"+y(100)+
         "' stroke='var(--iron)' stroke-width='1.5' stroke-dasharray='5 3' opacity='.5'/>";
  for(let hr=H0;hr<=H1;hr+=3)
    g += "<text class='ax' x='"+x(hr)+"' y='"+(H-8)+"' text-anchor='middle'>"+hourLabel(hr)+"</text>";

  const hrs = Object.keys(band).map(Number).filter(hr=>band[hr].length>=3).sort((a,b)=>a-b);
  const note = document.getElementById("chartNote");
  if(hrs.length>=3){
    const up = hrs.map(hr=>x(hr)+","+y(quantile(band[hr],.75))).join(" ");
    const dn = hrs.slice().reverse().map(hr=>x(hr)+","+y(quantile(band[hr],.25))).join(" ");
    g += "<polygon points='"+up+" "+dn+"' fill='var(--iron)' opacity='.10'/>";
    const mid = hrs.map(hr=>x(hr)+","+y(quantile(band[hr],.5))).join(" ");
    g += "<polyline points='"+mid+"' fill='none' stroke='var(--steel)' stroke-width='1.5' stroke-dasharray='4 4'/>";
    note.hidden = true;
  } else {
    note.hidden = false;
    note.innerHTML = "<b>No comparison band yet.</b> An hour needs three readings on other "+
      (weekendNow?"weekend days":"weekdays")+" before a typical range means anything.";
  }

  const pts = todayRows.filter(r=>r.t.getHours()>=H0&&r.t.getHours()<=H1)
    .map(r=>x(r.t.getHours()+r.t.getMinutes()/60)+","+y(pct(r)));
  if(pts.length){
    g += "<polyline points='"+pts.join(" ")+"' fill='none' stroke='var(--p25)' stroke-width='2.5' stroke-linejoin='round'/>";
    pts.forEach(p=>{const[a,b]=p.split(",");g+="<circle cx='"+a+"' cy='"+b+"' r='3.5' fill='var(--p25)'/>";});
  }

  // one invisible column per hour, so hover and tap both land somewhere
  const w = (W-PL-PR)/(H1-H0);
  for(let hr=H0;hr<=H1;hr++)
    g += "<rect class='hit' data-h='"+hr+"' x='"+(x(hr)-w/2)+"' y='"+PT+
         "' width='"+w+"' height='"+(H-PT-PB)+"'/>";

  const el = document.getElementById("chart");
  el.innerHTML = "<svg viewBox='0 0 "+W+" "+H+
    "' role='img' aria-label='Today compared with a typical day'>"+g+"</svg>";

  const read = document.getElementById("chRead");
  const hint = "<span class='dim'>Tap or hover the chart for that hour\u2019s numbers.</span>";
  const show = hr => {
    let s = "<b>"+hourLabel(hr)+"\u2013"+hourLabel((hr+1)%24)+"</b> \u00b7 ";
    const t = todayBy[hr];
    s += t ? "today <b>"+Math.round(quantile(t.map(pct),.5))+"%</b> ("+
             t.map(r=>r.count).join(", ")+" people)"
           : "<span class='dim'>no reading today</span>";
    const b = band[hr];
    s += b && b.length>=3
      ? " \u00b7 typical <b>"+Math.round(quantile(b,.5))+"%</b> (range "+
        Math.round(quantile(b,.25))+"\u2013"+Math.round(quantile(b,.75))+"%)"
      : " \u00b7 <span class='dim'>typical: not enough history</span>";
    read.innerHTML = s;
  };
  let locked = null;
  el.addEventListener("mousemove", e=>{
    const r = e.target.closest("rect.hit");
    if(r && locked===null) show(+r.dataset.h);
  });
  el.addEventListener("mouseleave", ()=>{ if(locked===null) read.innerHTML = hint; });
  el.addEventListener("click", e=>{
    const r = e.target.closest("rect.hit");
    if(!r) return;
    const hr = +r.dataset.h;
    locked = (locked===hr) ? null : hr;
    show(hr);
  });
  read.innerHTML = hint;
}

/* ---------- controls ---------- */
function buildControls(){
  document.getElementById("locSeg").innerHTML = Object.entries(LOCS)
    .map(([n,m])=>"<button data-loc=\""+n+"\" aria-pressed='"+(n===loc)+"'>"+m.short+"</button>").join("");
  document.getElementById("rangeSeg").innerHTML =
    "<button data-range='term' aria-pressed='"+(range==="term")+"'>This term</button>"+
    "<button data-range='all'  aria-pressed='"+(range==="all")+"'>All time</button>";
  document.querySelectorAll("#locSeg button").forEach(b=>
    b.onclick=()=>{loc=b.dataset.loc;buildControls();draw();});
  document.querySelectorAll("#rangeSeg button").forEach(b=>
    b.onclick=()=>{range=b.dataset.range;buildControls();draw();});
}

function draw(){
  const data = selected();
  renderNow();
  renderSlots(data);
  renderHeat(data);
  renderChart(data);
  const span = data.length ? ymd(data[0].t)+" → "+ymd(data[data.length-1].t) : "no readings";
  document.getElementById("foot").textContent =
    data.length + " readings · " + span +
    (range==="term" ? " · fall term only" : " · includes summer session");
}

async function load(){
  let ok = false;
  if(CSV_URL){
    try{
      const res = await fetch(CSV_URL, {cache:"no-store"});
      if(!res.ok) throw new Error("HTTP "+res.status);
      rows = fromCSV(await res.text());
      if(rows.length){ ok = true;
        document.getElementById("stamp").textContent = "Live · updated "+new Date().toLocaleTimeString();
      }
    }catch(e){
      document.getElementById("stamp").textContent = "Live feed unreachable — showing snapshot";
    }
  }
  if(!ok){
    rows = fromSnapshot(SNAPSHOT);
    if(!CSV_URL) document.getElementById("stamp").textContent = "Snapshot through 20 Aug 2026 · add a CSV URL to go live";
  }
  buildControls();
  draw();
}
load();
if(CSV_URL) setInterval(load, REFRESH_MS);
</script>
