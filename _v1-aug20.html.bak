<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SW Rec Crowd</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
:root{
  --chalk:#E8E6E0;
  --chalk-2:#DFDCD4;
  --iron:#1F1D1B;
  --steel:#6E6A64;
  --rack:#CFCBC3;
  /* IWF competition bumper plate colours, used as the crowding ramp */
  --p10:#2F7D3A;   /* green  - quiet   */
  --p15:#E8B517;   /* yellow - filling */
  --p25:#C8322B;   /* red    - packed  */
  --line:#C6C2B9;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--chalk);
  color:var(--iron);
  font-family:"IBM Plex Sans",system-ui,sans-serif;
  -webkit-font-smoothing:antialiased;
  padding:0 20px 64px;
}
.wrap{max-width:860px;margin:0 auto}

/* ---------- header ---------- */
header{padding:36px 0 20px;border-bottom:2px solid var(--iron)}
h1{
  font-family:Anton,Impact,sans-serif;
  font-weight:400;
  font-size:clamp(38px,9vw,64px);
  line-height:.92;
  letter-spacing:.01em;
  text-transform:uppercase;
  margin:0;
}
.sub{
  font-family:"IBM Plex Mono",monospace;
  font-size:11px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--steel);margin-top:10px;
}

/* ---------- controls ---------- */
.controls{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 4px}
.seg{display:flex;border:1.5px solid var(--iron)}
.seg button{
  appearance:none;background:transparent;border:0;
  border-right:1.5px solid var(--iron);
  font-family:"IBM Plex Mono",monospace;
  font-size:11px;letter-spacing:.1em;text-transform:uppercase;
  padding:9px 13px;cursor:pointer;color:var(--iron);
}
.seg button:last-child{border-right:0}
.seg button[aria-pressed="true"]{background:var(--iron);color:var(--chalk)}
.seg button:focus-visible{outline:3px solid var(--p15);outline-offset:2px}

/* ---------- sections ---------- */
section{padding:34px 0;border-bottom:1px solid var(--line)}
.eyebrow{
  font-family:"IBM Plex Mono",monospace;
  font-size:11px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--steel);margin:0 0 18px;
}

/* ---------- now readout ---------- */
.now{display:flex;align-items:flex-end;gap:26px;flex-wrap:wrap}
.count{
  font-family:"IBM Plex Mono",monospace;font-weight:600;
  font-size:clamp(60px,16vw,104px);line-height:.82;
  letter-spacing:-.03em;font-variant-numeric:tabular-nums;
}
.of{font-family:"IBM Plex Mono",monospace;font-size:13px;color:var(--steel);margin-top:10px}
.nowmeta{flex:1;min-width:210px;padding-bottom:6px}
.bar{height:14px;background:var(--rack);position:relative;overflow:hidden}
.bar i{display:block;height:100%;width:0;transition:width .5s ease}
.pctline{
  display:flex;justify-content:space-between;
  font-family:"IBM Plex Mono",monospace;font-size:12px;
  margin-top:8px;color:var(--steel);
}
.pctline b{color:var(--iron);font-weight:600}

/* ---------- best times ---------- */
.slots{display:flex;gap:10px;flex-wrap:wrap}
.slot{
  border:1.5px solid var(--iron);padding:12px 16px;
  font-family:"IBM Plex Mono",monospace;
}
.slot .t{font-size:17px;font-weight:600}
.slot .v{font-size:11px;color:var(--steel);margin-top:3px;letter-spacing:.06em}

/* ---------- heatmap ---------- */
.hmscroll{overflow-x:auto;margin:0 -20px;padding:0 20px}
table.hm{border-collapse:separate;border-spacing:3px;min-width:640px}
table.hm th{
  font-family:"IBM Plex Mono",monospace;font-weight:400;
  font-size:10px;color:var(--steel);letter-spacing:.06em;
  padding:0;text-align:center;
}
table.hm th.day{text-align:right;padding-right:8px;width:34px;
  font-size:11px;color:var(--iron);letter-spacing:.1em}
table.hm td{width:30px;height:26px;padding:0;background:var(--rack)}
table.hm td.thin{
  background:repeating-linear-gradient(45deg,var(--rack),var(--rack) 3px,var(--chalk-2) 3px,var(--chalk-2) 6px);
}
.legend{display:flex;gap:16px;flex-wrap:wrap;margin-top:18px;
  font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--steel)}
.legend span{display:flex;align-items:center;gap:7px}
.sw{width:15px;height:15px;display:inline-block}

/* ---------- chart ---------- */
svg{display:block;width:100%;height:auto}
.hit{fill:transparent;cursor:pointer}
.hit:hover{fill:var(--iron);fill-opacity:.05}

.readout{
  margin-top:14px;padding:11px 14px;
  border:1.5px solid var(--iron);background:var(--chalk-2);
  font-family:"IBM Plex Mono",monospace;font-size:12.5px;line-height:1.5;
  min-height:44px;
}
.readout b{font-weight:600}
.readout .dim{color:var(--steel)}
table.hm td{cursor:pointer}
table.hm td.sel{outline:2.5px solid var(--iron);outline-offset:1px}
.ax{font-family:"IBM Plex Mono",monospace;font-size:10px;fill:var(--steel)}

/* ---------- notes ---------- */
.note{
  font-size:13px;line-height:1.55;color:var(--steel);
  border-left:2px solid var(--p15);padding-left:14px;margin-top:16px;
}
.note b{color:var(--iron)}
footer{padding:28px 0;font-family:"IBM Plex Mono",monospace;
  font-size:11px;color:var(--steel);letter-spacing:.06em}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<div class="wrap">
<header>
  <h1>SW Rec<br>Crowd</h1>
  <div class="sub" id="stamp">Loading&hellip;</div>
</header>

<div class="controls">
  <div class="seg" id="locSeg"></div>
  <div class="seg" id="rangeSeg"></div>
</div>

<section>
  <p class="eyebrow">Right now</p>
  <div class="now">
    <div>
      <div class="count" id="nowCount">&mdash;</div>
      <div class="of" id="nowOf"></div>
    </div>
    <div class="nowmeta">
      <div class="bar"><i id="nowBar"></i></div>
      <div class="pctline"><span id="nowPct"></span><span id="nowAgo"></span></div>
    </div>
  </div>
  <div class="note" id="capNote" hidden></div>
</section>

<section>
  <p class="eyebrow">Quietest hours</p>
  <div class="slots" id="slots"></div>
</section>

<section>
  <p class="eyebrow">By hour and day</p>
  <div class="hmscroll"><table class="hm" id="hm"></table></div>
  <div class="readout" id="hmRead"><span class="dim">Tap or hover any block for that hour's numbers.</span></div>
  <div class="legend">
    <span><i class="sw" style="background:var(--p10)"></i>Quiet</span>
    <span><i class="sw" style="background:var(--p15)"></i>Filling</span>
    <span><i class="sw" style="background:var(--p25)"></i>Packed</span>
    <span><i class="sw" style="background:var(--rack)"></i>No readings</span>
    <span><i class="sw" style="background:var(--p15);opacity:.34"></i>Faded = one reading only</span>
  </div>
</section>

<section>
  <p class="eyebrow">Today against a typical <span id="dayKind">weekday</span></p>
  <div id="chart"></div>
  <div class="readout" id="chRead"><span class="dim">Tap or hover the chart for that hour's numbers.</span></div>
  <div class="note" id="chartNote" hidden></div>
</section>

<footer id="foot"></footer>
</div>

<script>
/* ═══════════════════════════════════════════════════════════
   CONFIG — paste the published CSV URL here once you publish
   the Log tab (File → Share → Publish to web → Log → CSV).
   Leave blank to run on the built-in snapshot.
   ═══════════════════════════════════════════════════════════ */
const CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vT2fBqGyWQtp53Cb0TO_RHQuuqpaBVo0o5t8QtJzcr0vZ9XY6oFsAwr0OHJw1zrSV20uMy9ukSu2aMX/pub?output=csv";

const REFRESH_MS = 60000;

/* zeroMeansClosed: the board reports 0 both for "empty" and for "closed", and
   IsClosed is not trustworthy — it read false at 10:11pm on a night SWRC shut
   at 10pm, and false 4 min before SRFC opened. Checked against RecSports'
   posted August hours, all 7 weight-room zeros fall outside operating hours
   and none is a genuinely empty open room. The outdoor volleyball court is
   the opposite case: 0 is its normal state, so its zeros are kept. */
const LOCS = {
  "SWRC Weight Room":   {code:"S", short:"SWRC",       cap:300, zeroMeansClosed:true},
  "SRFC Weight Room":   {code:"R", short:"SRFC",       cap:50,  zeroMeansClosed:true},
  "UVS Sand Volleyball":{code:"V", short:"Volleyball", cap:100, zeroMeansClosed:false}
};
const BY_CODE = {}; for (const [n,m] of Object.entries(LOCS)) BY_CODE[m.code] = {...m, name:n};

/* Fall term began Aug 17 2026. Counts roughly tripled overnight, so
   averaging across the boundary produces a heatmap of nothing. */
